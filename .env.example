LOAD_LTX23_PIPELINE=false
LOAD_LOCAL_PIPELINE=false
LOAD_LTX23_CONDITION=false
LTX23_CPU_OFFLOAD=true
RUN_GENERATION_INLINE=true
PRELOAD_MODEL_FILES=false
TWITCH_CHANNEL=your_channel
OPENAI_API_KEY=
# Local-first safety: credentials never imply permission to spend.
USE_FAL_OPENROUTER=false
ENABLE_FAL_VIDEO=false
# FAL_KEY=                         # Optional; only for explicit cloud mode.
TWITCH_STREAM_KEY=

# Local ComfyUI LTX 2.5 bridge
COMFY_SERVER=127.0.0.1:8188
# Required for I2V handoff frames. Override INPUT/OUTPUT separately if needed.
COMFYUI_DIR=C:\path\to\ComfyUI
# COMFY_INPUT_DIR=C:\path\to\ComfyUI\input
# COMFY_OUTPUT_DIR=C:\path\to\ComfyUI\output
LTX25_MAX_CORRUPT_RETRIES=2
LTX25_RECOVERY_INSET_RATIO=0.18
RTMP_TARGET_QUEUE_SECONDS=18

# Optional local OpenAI-compatible LLM endpoint.
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_TEXT_MODEL=local
# LLM_VISION_MODEL=

LTX23_WEIGHTS_DIR=./models/ltx-2.3-distilled-v2
LTX_WEIGHTS_DIR=./models/ltx-video-0.9.8-13b
